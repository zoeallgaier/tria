<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Push Notifications capability. Without this entitlement
	     registerForRemoteNotifications() fails outright with "no valid aps-
	     environment entitlement string found", which is the one push failure
	     that DOES announce itself (didFailToRegister fires) — everything else
	     about push goes quiet instead.

	     "development" is correct here and does not need a release variant:
	     codesign rewrites it to "production" when the archive is signed with a
	     distribution profile, so a debug build talks to APNs sandbox and the
	     App Store build talks to APNs production off this same line. That split
	     is why the sender has to try both hosts — see functions/push/index.ts.

	     It only works if the App ID itself has Push Notifications enabled in the
	     developer portal; automatic signing can add the capability to the
	     profile but not to the App ID. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Sign in with Apple. Without this entitlement the system sheet never
	     appears: ASAuthorizationController answers its delegate with error
	     1000 ("The operation couldn't be completed"), which names nothing and
	     is indistinguishable from the person cancelling.

	     Like aps-environment above, it only works if the App ID itself has the
	     capability enabled in the developer portal. Automatic signing will put
	     it in the profile and cannot put it on the App ID, so the build
	     succeeds, the button appears, and the tap does nothing.

	     "Default" is the whole capability. The other value, "Existing", is for
	     migrating accounts off an existing Apple-ID-backed login, which Tria
	     has never had. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
