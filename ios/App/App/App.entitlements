<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Push Notifications capability. Without this entitlement
	     registerForRemoteNotifications() fails outright with "no valid aps-
	     environment entitlement string found", which is the one push failure
	     that DOES announce itself (didFailToRegister fires) — everything else
	     about push goes quiet instead.

	     "development" is correct here and does not need a release variant:
	     codesign rewrites it to "production" when the archive is signed with a
	     distribution profile, so a debug build talks to APNs sandbox and the
	     App Store build talks to APNs production off this same line. That split
	     is why the sender has to try both hosts — see functions/push/index.ts.

	     It only works if the App ID itself has Push Notifications enabled in the
	     developer portal; automatic signing can add the capability to the
	     profile but not to the App ID. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
