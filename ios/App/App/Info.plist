<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Tria</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- The scheme a provider sign-in comes back on. ASWebAuthenticationSession
	     is handed "tria" as its callbackURLScheme (TriaAuthPlugin.webAuth) and
	     iOS will only route a redirect to a scheme this app has DECLARED, so a
	     missing entry here is a sheet that sits open forever with no error
	     anywhere. The matching URL, tria://auth-callback, also has to be in the
	     Supabase project's Redirect URLs allow list — see supabase/OAUTH-SETUP.md.

	     Sign in with Apple needs none of this: it is a native sheet and never
	     leaves the app. This is Google's road, and anyone else's later. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tria</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- canOpenURL answers false for any scheme not listed here, whatever is
	     installed. Spotify and YouTube Music are asked about so a song's link
	     can open in the service the reader actually uses (see
	     TriaSettingsPlugin.musicApps). Apple Music is deliberately absent: it
	     ships preinstalled, so its presence would tell us nothing about anybody. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>youtubemusic</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Tria uses your camera so you can take a photo or a short video to share in a post.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tria uses your microphone so a Frame video can have sound.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tria uses your photo library so you can pick a photo or video to share in a post.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Oxygen-Bold.ttf</string>
		<string>Oxygen-Regular.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarHidden</key>
	<false/>
	<!-- Tria is portrait, and this key is the one the app actually reads:
	     UIDeviceFamily is 1, so every device that runs it is an iPhone and the
	     ~ipad key below is never consulted at runtime. It is there because App
	     Store Connect asks for it anyway. The asset catalog is built with
	     ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES, so the bundle
	     carries a 76x76 ~ipad icon and CFBundleIcons~ipad whatever the device
	     family says, and the validator reads that as an app that can land on an
	     iPad and must therefore answer for multitasking. Declaring all four for
	     the iPad idiom satisfies it and changes nothing on a phone. Do not put
	     the other three in the key above. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
